# TriageIQ Environment Configuration Template
# Copy this file to .env and set your API keys (all keys are optional; offline mocks will activate if missing)

# Groq LLM API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# VirusTotal v3 API Key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AbuseIPDB v2 API Key (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Optional: LangChain LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=TriageIQ
